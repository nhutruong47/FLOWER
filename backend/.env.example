# FlowerChain Backend Environment Template (.env.example)
# Copy to .env locally and replace placeholders. Never commit real .env files.

SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/flowerchain
SPRING_DATASOURCE_USERNAME=flowerchain
SPRING_DATASOURCE_PASSWORD=change_me_in_local_env
FLOWERCHAIN_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Sandbox payment webhook adapter (ADR-0007). Keep it off outside local development and CI.
FLOWERCHAIN_PAYMENT_SANDBOX_HMAC_ENABLED=false
# Shared HMAC secret for sandbox-hmac webhooks: at least 32 random characters. Left empty on purpose: an empty or
# placeholder value makes the server reject every sandbox-hmac webhook (fail closed).
FLOWERCHAIN_PAYMENT_SANDBOX_HMAC_WEBHOOK_SECRET=
